# =============================================================================
# Barber Voice — variáveis de ambiente (EXEMPLO)
# Copie para .env e ajuste. NUNCA versione o arquivo .env nem coloque segredos
# em variáveis NEXT_PUBLIC_* (elas são expostas ao navegador).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Banco de dados (PostgreSQL 16+)
# ----------------------------------------------------------------------------
# Papel da APLICAÇÃO: sem BYPASSRLS, sempre sujeito às políticas de Row-Level Security.
DATABASE_URL=postgres://barber_app:barber_app_dev@localhost:5432/barber_voice
# Papel DONO do schema: migrações, seeds e rotinas de plataforma (superadmin, jobs
# que varrem vários estabelecimentos). Nunca usar em handlers comuns de estabelecimento.
DATABASE_ADMIN_URL=postgres://barber_owner:barber_owner_dev@localhost:5432/barber_voice
# Nome do papel da aplicação que recebe GRANTs após as migrações.
DB_APP_ROLE=barber_app

# Bancos usados pelos testes automatizados (são migrados automaticamente).
TEST_DATABASE_URL=postgres://barber_app:barber_app_dev@localhost:5432/barber_voice_test
TEST_DATABASE_ADMIN_URL=postgres://barber_owner:barber_owner_dev@localhost:5432/barber_voice_test

# ----------------------------------------------------------------------------
# Redis (rate limiting distribuído; filas a partir da Fase 4). Opcional em dev.
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# API (apps/api)
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Origens autorizadas a fazer requisições com cookie (CORS + verificação CSRF de Origin).
WEB_ORIGIN=http://localhost:3000
# URL pública do painel, usada em links de e-mail (redefinição de senha etc.).
PUBLIC_WEB_URL=http://localhost:3000
SESSION_COOKIE_NAME=bv_session
# true em produção (HTTPS). Em dev local via http, mantenha false.
COOKIE_SECURE=false
# Proxies confiáveis para obter o IP real (ex.: "loopback", "10.0.0.0/8" ou "true").
TRUST_PROXY=loopback
# Chave de criptografia (AES-256-GCM) para segredos de integrações dos estabelecimentos.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Web (apps/web) — usado pelo servidor Next.js para encaminhar /api/* à API.
# ----------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# E-mail transacional
# ----------------------------------------------------------------------------
# console = apenas registra no log (desenvolvimento). Provedores reais: ver docs/INTEGRATIONS.md
MAIL_PROVIDER=console
MAIL_FROM="Barber Voice <nao-responda@barbervoice.com.br>"

# ----------------------------------------------------------------------------
# Recepcionista de IA (Anthropic). Sem chave, o atendimento por IA e o simulador
# ficam "não integrados" — nada é simulado. Cada mensagem gera custo de uso.
# A chave fica SOMENTE no servidor (nunca no painel/navegador).
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# ----------------------------------------------------------------------------
# Integrações das próximas fases — ainda NÃO utilizadas pelo código.
# Ver docs/INTEGRATIONS.md para contas, credenciais e custos de cada uma.
# ----------------------------------------------------------------------------
# Voz: síntese (TTS) e reconhecimento (STT)
# TTS_PROVIDER=
# STT_PROVIDER=
# Telefonia SIP/VoIP
# TELEPHONY_PROVIDER=
# WhatsApp Business Platform (Cloud API oficial da Meta)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Pagamentos
# PAYMENTS_PROVIDER=
