{
  "name": "@barber-voice/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camada de dados do Barber Voice: schema Drizzle, migrações SQL, RLS e utilitários multi-tenant.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "make-superadmin": "tsx scripts/make-superadmin.ts"
  },
  "dependencies": {
    "@barber-voice/core": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
