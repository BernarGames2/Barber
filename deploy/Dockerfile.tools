# syntax=docker/dockerfile:1
# Ferramentas de banco para produção: migrações, seeds (planos e personagens) e superadmin.
# Usada pelo serviço "migrate" do docker-compose.prod.yml antes de a API subir.
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
RUN pnpm install --frozen-lockfile --filter "@barber-voice/db..."
COPY packages/core packages/core
COPY packages/db packages/db
USER node
CMD ["sh", "-c", "pnpm db:migrate && pnpm db:seed"]
